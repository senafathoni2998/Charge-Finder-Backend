# Copy this file to `.env` (untracked) and fill in real values.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# JWT signing key and Express session secret (REQUIRED — app throws if SESSION_SECRET is unset)
SECRET_KEY=
SESSION_SECRET=

# Redis Configuration
# Option 1: Include password in URL: redis://:yourpassword@localhost:6379
# Option 2: Use separate REDIS_PASSWORD variable (if REDIS_URL has no password)
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

DB_HOST=mongodb.net
DB_USER=user_db
DB_PASSWORD=password_db
DB_NAME=ChargeFinder
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
ADMIN_REGION=Jakarta
BATTERY_CAPACITY_DEFAULT=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
SIGNUP_RATE_LIMIT_MAX=5
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://another-domain.com
# Set to 'true' to disable user signup (returns 503 error and prevents data persistence)
DISABLE_SIGNUP=false
# Set to 'true' to enable demo data (creates demo user with vehicles and charging history)
ENABLE_DEMO_DATA=false
